#!/usr/bin/env python3
"""alp-extract: Convert raw text/transcript into an ALP vault."""

import sys, os, yaml, re, json
from pathlib import Path

def chunk_by_headings(text):
    """Split markdown text by ## headings (or H1 if no H2)."""
    lines = text.split("\n")
    chunks = []
    current = {"heading": "Introduction", "body": []}

    for line in lines:
        h = re.match(r'^(#{1,2})\s+(.+)$', line)
        if h:
            if current["body"]:
                chunks.append(current)
            current = {"heading": h.group(2), "body": []}
        else:
            current["body"].append(line)

    if current["body"]:
        chunks.append(current)
    return chunks

def sanitize_id(s):
    return re.sub(r'[^a-z0-9-]', '', s.lower().replace(' ', '-')).strip('-')[:40]

def extract(vault_name, text, source_url="", source_type="doc"):
    chunks = chunk_by_headings(text)
    vault_dir = Path(vault_name)
    vault_dir.mkdir(exist_ok=True)
    (vault_dir / "concepts").mkdir(exist_ok=True)

    curriculum = []
    for i, chunk in enumerate(chunks):
        cid = sanitize_id(chunk["heading"]) or f"section-{i:02d}"
        curriculum.append({
            "id": cid,
            "title": chunk["heading"],
            "path": f"concepts/{i+1:02d}-{cid}.md"
        })

        body = "\n".join(chunk["body"]).strip()
        fm = {
            "type": "alp-concept",
            "id": cid,
            "title": chunk["heading"],
            "prerequisites": [curriculum[-2]["id"]] if i > 0 else [],
        }
        concept_content = f"---\n{yaml.dump(fm, default_flow_style=False).strip()}\n---\n\n{body}\n"
        (vault_dir / "concepts" / f"{i+1:02d}-{cid}.md").write_text(concept_content)

    # write alp.md
    meta = {
        "type": "alp-vault",
        "alp-version": "0.1",
        "name": sanitize_id(vault_name),
        "version": "1.0.0",
        "description": f"Extracted from {source_url or 'source'}",
        "source": source_url or "",
        "source-type": source_type,
        "prerequisites": [],
        "curriculum": curriculum,
        "tags": [sanitize_id(vault_name)],
    }
    (vault_dir / "alp.md").write_text(
        f"---\n{yaml.dump(meta, default_flow_style=False, sort_keys=False).strip()}\n---\n"
    )
    print(f"✅ ALP vault created: {vault_dir}")
    print(f"   {len(curriculum)} concepts")
    print(f"   Run: alp-learn --vault {vault_dir}")

if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser(description="Convert text to ALP vault")
    parser.add_argument("--name", required=True, help="Vault name (directory)")
    parser.add_argument("--file", help="Input file (default: stdin)")
    parser.add_argument("--source", default="", help="Source URL")
    parser.add_argument("--type", default="doc", choices=["youtube", "blog", "doc", "screencast", "live-lecture"])
    args = parser.parse_args()

    if args.file:
        text = Path(args.file).read_text()
    else:
        text = sys.stdin.read()

    extract(args.name, text, args.source, args.type)
